# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Release signing material. The keystore must never enter the repository: once
# it is in a commit it is published forever, and the only remedy is a new
# application id — every existing installation would refuse to upgrade.
#
#   android/key.properties   storeFile / storePassword / keyAlias / keyPassword
#   *.jks *.keystore         the keystore itself, wherever it was put
#
# CI reads the same four values from repository secrets instead; see
# .github/workflows/release.yml and the signing block in
# android/app/build.gradle.kts.
/android/key.properties
*.jks
*.keystore

# Gradle's own output. The `/build/` above is ANCHORED TO THE REPOSITORY ROOT —
# a leading slash means "here", not "anywhere" — so it never covered
# `android/build/`, and `android/.gitignore` (the Flutter template's) does not
# list it either. Found by listing what `git` would actually add: a 132 KB
# `android/build/reports/problems/problems-report.html` was in the list.
/android/build/

# Patrol's generated build inputs and reports. `test_bundle.dart` says so in
# its own header: it is regenerated on every `patrol test` and lists the test
# files that exist at that moment, so committing it means committing a stale
# list of tests.
/patrol_test/test_bundle.dart
/patrol_test/.patrol/
build/app/reports/

# The workspace-level planning directory (plannings/) lives OUTSIDE this repository
# (the workspace root is not a git repo), so this entry is a guard: if anyone ever
# runs git from a directory where plannings/ IS reachable, it must not be added.
plannings/
.pi/tasks
