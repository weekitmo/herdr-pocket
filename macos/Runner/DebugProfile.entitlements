<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Sandbox is OFF on purpose.

	     A herdr client is not a sandboxable app: it must read the daemon socket
	     under the user's home directory (~/.config/herdr/herdr.sock), read the
	     user's SSH keys, and open outbound SSH connections. A sandboxed app can
	     do none of those things, so leaving the sandbox on would produce an app
	     that launches and then cannot do the one thing it exists for.

	     This mirrors how other herdr desktop tooling ships (hardened runtime,
	     Developer ID, not sandboxed, outside the Mac App Store). -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
