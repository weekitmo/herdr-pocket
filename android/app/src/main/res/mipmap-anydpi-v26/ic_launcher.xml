<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive icon: the mark is a separate layer from the ground, so the
  launcher can mask it to whatever shape the device uses without cropping the
  glyph. The foreground is rendered on a 108dp canvas with the mark inside the
  central 66dp safe zone — that margin is not padding, it is the room every
  launcher shape is allowed to cut into.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
