<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- THE APP'S OWN NETWORK PERMISSION, and it has to be declared HERE.
         Flutter's template puts INTERNET in `src/debug/` and `src/profile/`
         only, with a comment explaining that the tooling needs it for hot
         reload. For a template app that is accurate. For this one it is
         exactly backwards: the entire product is an SSH connection, and
         reading "required for development" as "only needed for development"
         is how a release build shipped that could not open a socket at all.
         Debug builds worked the whole time — they were getting the permission
         from the debug manifest. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Reading the phone's HTTP proxy, so an update download honours the proxy
         the user configured instead of quietly going direct.

         `normal` protection level (AOSP core AndroidManifest.xml), so there is
         no prompt and nothing for the user to grant — but `ConnectivityManager`
         throws a SecurityException without it, which would silently read as
         "this phone has no proxy". Both `getDefaultProxy()` and
         `LinkProperties.getHttpProxy()` go through the same check. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Handing a downloaded APK to the system installer.

         Declared here BEFORE anything is asked at runtime, for the same reason
         POST_NOTIFICATIONS is: this is the half that makes the runtime half
         meaningful. On Android 8+ the user grants it per app, in
         Settings → Apps → Special access → Install unknown apps, and the app
         asks `PackageManager.canRequestPackageInstalls()` before it offers the
         install button.

         AOSP gives this permission protection level `signature`, which reads
         alarming and is not: every side-loading app that installs its own
         updates declares it, and the real gate is the per-app special access
         above, which only the user can flip. There is no silent install on
         Android without device owner or root, and this app is neither. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <!-- Android 13 (SDK 33) made notifications a runtime permission, but it
         still has to be DECLARED before the runtime request does anything.
         `requestNotificationsPermission()` in agent_notifier.dart is the
         runtime half; this is the half that was missing, so the switch in
         Settings was flipping a feature that could never fire. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- KEEPING THE CONNECTION ALIVE WHILE THE APP IS IN THE BACKGROUND.

         Android freezes a backgrounded app's process, and a frozen process
         writes no SSH keepalive — so the connection dies in the middle with
         neither end told. A foreground service is the only mechanism Android
         offers for that, and it needs these two declarations plus the service
         below.

         DECLARATIONS ARE NOT BEHAVIOUR: the service is started and stopped by
         this app's own code (see KeepAliveService), so the switch in Settings
         turns it on and off at runtime and the notification appears only while
         it runs. Special use is the honest type — there is no category for "the
         user asked this app to hold a connection to their own machine open" —
         and its subtype below is what a reviewer (or the user, in Settings →
         Apps) reads to find out why. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>

    <application
        android:label="Herdr Pocket"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- THE ONLY WAY AN APK IN PRIVATE STORAGE REACHES THE INSTALLER.

             A `file://` URI is refused outright on Android 7+ (FileUriExposed-
             Exception), and the right answer is a content URI from a provider —
             which is this. `filesDir/updates` is not reachable by any other app,
             so the grant below is the entire exposure, and it lasts exactly as
             long as the install intent (`FLAG_GRANT_READ_URI_PERMISSION`).

             `exported="false"` and a `${applicationId}`-scoped authority: the
             provider is ours alone, and the authority cannot collide with
             another app's. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <!-- The keep-alive service. Not exported: only this app starts it.
             `stopWithTask="false"` because swiping the app off the recents list
             is exactly the moment the user expects the connection to survive —
             the task going away is not a request to disconnect. -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Holds an SSH connection to a machine the user added, so it survives the app going to the background and agent notifications keep arriving." />
        </service>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
